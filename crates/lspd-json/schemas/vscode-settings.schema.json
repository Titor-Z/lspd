{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VSCode Settings",
  "type": "object",
  "properties": {
    "editor.formatOnSave": {
      "type": "boolean",
      "description": "保存文件时自动格式化。"
    },
    "editor.tabSize": {
      "type": "number",
      "description": "一个制表符等于的空格数。"
    },
    "editor.insertSpaces": {
      "type": "boolean",
      "description": "按 Tab 时插入空格。"
    },
    "editor.wordWrap": {
      "type": "string",
      "description": "控制折行方式。",
      "enum": [
        "off",
        "on",
        "wordWrapColumn",
        "bounded"
      ]
    },
    "editor.defaultFormatter": {
      "type": "string",
      "description": "默认格式化器扩展标识。"
    },
    "files.exclude": {
      "type": "object",
      "description": "资源管理器中隐藏的文件/文件夹 glob 模式。",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "files.associations": {
      "type": "object",
      "description": "文件名模式到语言标识的映射。",
      "additionalProperties": {
        "type": "string"
      }
    },
    "files.eol": {
      "type": "string",
      "description": "默认行尾字符。",
      "enum": [
        "\n",
        "\r\n",
        "auto"
      ]
    },
    "search.exclude": {
      "type": "object",
      "description": "搜索时排除的 glob 模式。",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "terminal.integrated.defaultProfile.osx": {
      "type": "string",
      "description": "macOS 上默认终端配置。"
    },
    "terminal.integrated.defaultProfile.linux": {
      "type": "string",
      "description": "Linux 上默认终端配置。"
    },
    "terminal.integrated.defaultProfile.windows": {
      "type": "string",
      "description": "Windows 上默认终端配置。"
    },
    "[json]": {
      "type": "object",
      "description": "仅对 JSON 语言生效的设置。"
    },
    "[jsonc]": {
      "type": "object",
      "description": "仅对 JSONC 语言生效的设置。"
    },
    "[markdown]": {
      "type": "object",
      "description": "仅对 Markdown 语言生效的设置。"
    }
  }
}
